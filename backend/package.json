    "react-dom": "^19.0.0",
    "swagger-ui-react": "^5.32.14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.0",
    "vitest": "^4.0.8"
  }
