DATABASE_URL="******HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
GOOGLE_CLIENT_ID=************************************************************************
TIBIA_DATA_API_BASE_URL=https://dev.tibiadata.com/v4
CHARACTER_SNAPSHOT_TTL_MINUTES=15
CRON_WORLDS=Dia,Amera,Antica
# Sekrety podpisu cookie sesji. Lokalnie bez nich backend używa sekretu
# deweloperskiego; w produkcji brak sekretu blokuje start serwera.
SESSION_JWT_SECRET=change-me-session-secret
SESSION_REFRESH_SECRET=change-me-refresh-secret
# Token wymagany przez /api/cron/highscores (nagłówek Authorization: Bearer).
CRON_AUTH_TOKEN=change-me-cron-token
# Zweryfikowane konta Google z tej listy dostają rolę admin przy logowaniu.
ADMIN_EMAILS=
# Retencja historii czyszczonej przez cron (w dniach).
HIGHSCORES_SNAPSHOT_RETENTION_DAYS=365
CHARACTER_LOOKUP_RETENTION_DAYS=90
