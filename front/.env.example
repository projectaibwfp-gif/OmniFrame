# Local dev: Vite proxies /api to the backend (same-origin), so /api works.
# On Vercel set this to the backend origin so the app calls it directly
# (cross-origin, credentialed) instead of via the broken /api rewrite:
#   VITE_API_BASE_URL=https://apiomniframe.vercel.app/api
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=************************************************************************
