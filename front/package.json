{
  "name": "project-ai-front",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -p tsconfig.app.json --outDir ./out-tsc/app && vite build",
    "lint": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --max-warnings=0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/router": "22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/build-angular": "22.0.0",
    "@angular/build": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@eslint/js": "^9.39.5",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.93.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.4",
    "vitest": "^4.0.8"
  }
}
